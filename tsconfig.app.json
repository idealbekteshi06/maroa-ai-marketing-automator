{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/components/AIBrainStatus.tsx",
    "src/components/CharacterTrainer.tsx",
    "src/components/CompetitorAlert.tsx",
    "src/components/CreativeConceptApproval.tsx",
    "src/components/ImageVetter.tsx",
    "src/components/NotificationCenter.tsx",
    "src/components/PendingApprovals.tsx",
    "src/components/PerformanceAlert.tsx",
    "src/components/dashboard"
  ]
}