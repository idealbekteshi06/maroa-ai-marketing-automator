# Production (Vercel) — required for maroa.ai to talk to Railway API
VITE_API_BASE=https://maroa-api-production.up.railway.app

# Supabase (from project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# OAuth — register this exact URI in Meta / TikTok / LinkedIn developer consoles
VITE_OAUTH_REDIRECT_URI=https://maroa.ai/social-callback

# Optional — defaults to built-in Meta app id if unset
# VITE_META_APP_ID=26551713411132003
